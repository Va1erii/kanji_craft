</sense>
<sense>
<xref>化す</xref>
<gloss>to become</gloss>
</sense>
</entry>
<!-- Entry 3: 大きい — entry with restricted reading and lsource -->
<entry>
<ent_seq>1221850</ent_seq>
<k_ele>
<keb>大きい</keb>
<ke_pri>ichi1</ke_pri>
</k_ele>
<r_ele>
<reb>おおきい</reb>
<re_pri>ichi1</re_pri>
</r_ele>
<sense>
<pos>&adj-i;</pos>
<gloss>big</gloss>
<gloss>large</gloss>
<gloss xml:lang="ger">groß</gloss>
</sense>
</entry>
</JMdict>
