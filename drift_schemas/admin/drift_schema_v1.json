      ]
    },
    {
      "name": "raw_kanji_vg_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"raw_kanji_vg_entries\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"import_id\" INTEGER NOT NULL REFERENCES data_import_entries (id), \"character\" TEXT NOT NULL, \"unicode_hex\" TEXT NOT NULL, \"view_box\" TEXT NOT NULL, \"stroke_count\" INTEGER NOT NULL, \"strokes\" TEXT NOT NULL, \"components\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, UNIQUE (\"import_id\", \"character\"));"
        }
      ]
    },
    {
      "name": "raw_kanjidic_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"raw_kanjidic_entries\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"import_id\" INTEGER NOT NULL REFERENCES data_import_entries (id), \"literal\" TEXT NOT NULL, \"stroke_count\" INTEGER NOT NULL, \"stroke_count_misstrokes\" TEXT NULL, \"grade\" INTEGER NULL, \"jlpt\" INTEGER NULL, \"frequency\" INTEGER NULL, \"codepoints\" TEXT NOT NULL, \"radicals\" TEXT NOT NULL, \"dict_refs\" TEXT NULL, \"query_codes\" TEXT NULL, \"readings\" TEXT NOT NULL, \"nanori\" TEXT NULL, \"meanings\" TEXT NOT NULL, \"variants\" TEXT NULL, \"radical_names\" TEXT NULL, \"created_at\" TEXT NOT NULL, UNIQUE (\"import_id\", \"literal\"));"
