<re_pri>ichi1</re_pri>
<re_pri>news2</re_pri>
</r_ele>
<sense>
<pos>&n;</pos>
<gloss>to eat</gloss>
<gloss xml:lang="fre">manger</gloss>
</sense>
</entry>
<!-- Entry 2: する — kana-only entry (no k_ele) -->
<entry>
<ent_seq>1157170</ent_seq>
<r_ele>
<reb>する</reb>
<re_pri>ichi1</re_pri>
</r_ele>
<sense>
