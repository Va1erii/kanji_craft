    {
      "name": "data_import_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"data_import_entries\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"source\" TEXT NOT NULL, \"source_version\" TEXT NOT NULL, \"status\" TEXT NOT NULL DEFAULT 'pending', \"record_count\" INTEGER NULL, \"started_at\" TEXT NOT NULL, \"ingested_at\" TEXT NULL, \"processed_at\" TEXT NULL, \"promoted_at\" TEXT NULL, \"error_message\" TEXT NULL, \"metadata\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL);"
